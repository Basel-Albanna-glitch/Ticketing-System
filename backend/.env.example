DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to "sqlite" for local dev without Postgres installed; unset/anything else uses Postgres below.
DB_ENGINE=

POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email
# Leave DJANGO_EMAIL_BACKEND unset in dev: emails are printed to the server console.
# To actually DELIVER emails (e.g. status-change notifications), set the SMTP backend
# and fill in your provider's details below.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Hermes Support <you@example.com>
# FRONTEND_URL=http://localhost:5173

# WhatsApp (Meta Cloud API) — notify guests of status changes on their phone.
# Needs an approved template whose body has 3 variables: {{1}} id, {{2}} subject, {{3}} status.
# WHATSAPP_ACCESS_TOKEN=EAAG...your-token
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=ticket_status_update
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_DEFAULT_COUNTRY_CODE=962   # e.g. convert local 07... to 9627...
# WhatsApp yourself (staff) when a NEW ticket is opened — comma-separated numbers.
# Reuses the same approved template. Leave blank for no new-ticket alerts.
# WHATSAPP_NOTIFY_NUMBERS=962791234567,962799876543
