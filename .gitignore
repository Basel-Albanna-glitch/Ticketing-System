# Python / Django
.venv/
__pycache__/
*.pyc
backend/staticfiles/
backend/media/
*.sqlite3

# Node / React
frontend/node_modules/
frontend/dist/

# Env
.env
backend/.env
frontend/.env

# Firebase service-account key for push notifications. This holds a real private
# key that can send messages to every install of the app — it must never be
# committed. (mobile/android/app/google-services.json is NOT secret by contrast:
# it ships inside every APK, so committing that one is fine.)
*service-account*.json
backend/firebase-*.json

# Editor / OS
.idea/
.vscode/
.DS_Store

# Docker
postgres_data/
# Local DB backups. These hold real ticket and customer data. The datestamped
# names (db.sqlite3.20260730-094436.bak) fall between *.sqlite3 and *.sqlite3.bak,
# so both of those patterns miss them — match the db.sqlite3 prefix instead.
*.sqlite3.bak
db.sqlite3.*

# Stale vite-plugin-pwa dev output
frontend/dev-dist/
.env.prod
secrets/

# Published APK builds, copied to the server rather than committed.
downloads/
