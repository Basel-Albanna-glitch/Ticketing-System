# Copy to .env.prod on the server and fill in real values. Never commit .env.prod.
#
# Generate a secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Public IP (or domain) of the host. Django rejects any request whose Host header
# is not listed here. Include the bare IP; no scheme, no port.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,YOUR.EC2.IP.HERE

# Needed for the Django admin login form to pass CSRF checks. Scheme IS required.
CSRF_TRUSTED_ORIGINS=http://YOUR.EC2.IP.HERE

# Used to build links inside notification emails.
FRONTEND_URL=http://YOUR.EC2.IP.HERE

# Leave blank: the SPA is served from the same origin as the API, so no CORS.
# Only fill this in if the mobile app points at this server.
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
# Use a long random value, not the dev default.
POSTGRES_PASSWORD=

# Email. Defaults to printing to the container log; switch to SMTP for real mail.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Hermes Support <no-reply@hermes.local>

# WhatsApp (Meta Cloud API). Blank disables it.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_DEFAULT_COUNTRY_CODE=962
# WHATSAPP_NOTIFY_NUMBERS=

# Firebase push. Put the JSON key at ./secrets/firebase.json on the host.
# FCM_SERVICE_ACCOUNT_FILE=/app/secrets/firebase.json
